{
  "name": "tarte-aux-etrons",
  "version": "0.2.1",
  "description": "Parce que les cookies, c'est de la merde. Une lib RGPD moderne, typée, et qui assume.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "playground": "vite",
    "build:playground": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "rgpd",
    "gdpr",
    "cookies",
    "consent",
    "banner"
  ],
  "author": {
    "name": "David Essayan",
    "email": "da.essayan@gmail.com",
    "url": "https://github.com/davidessayan"
  },
  "license": "MIT",
  "homepage": "https://tarteauxetrons.creative-bones.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidessayan/tarte-aux-etrons.git"
  },
  "bugs": {
    "url": "https://github.com/davidessayan/tarte-aux-etrons/issues"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
